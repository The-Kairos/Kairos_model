# Kairos environment variables
# Copy this file to .env and fill in your values.

# ── LLM backend ──────────────────────────────────────────────
# "gemini" or "openai" (also settable via --llm CLI flag)
LLM_BACKEND=gemini

# ── Gemini (Vertex AI, uses VM default credentials) ─────────
GEMINI_PROJECT=
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_RAG_MODEL=gemini-2.5-pro

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_ENDPOINT=
OPENAI_KEY=
OPENAI_DEPLOYMENT=
OPENAI_MODEL=gpt-4o

# ── Whisper API (optional, for cloud speech-to-text) ────────
WHISPER_API_KEY=
WHISPER_API_ENDPOINT=
WHISPER_API_DEPLOYMENT=
WHISPER_API_VERSION=2024-12-01-preview
