        "end_timecode": "00:06:24.960",
        "audio_speech": "And a nation will tango all night long.",
        "audio_natural": "speech (conf=0.65)"
    },
    {
        "scene_index": 61,
        "start_timecode": "00:06:24.960",
        "end_timecode": "00:06:27.200",
        "audio_speech": "36 years since Maradona and Mexico.",
        "audio_natural": "speech (conf=0.43)"
    },
    {
        "scene_index": 62,
        "start_timecode": "00:06:27.200",
        "end_timecode": "00:06:31.680",
        "audio_speech": "36 years since Maradona and Mexico. Here, finally.",
        "audio_natural": "speech (conf=0.56)"
    },
    {
        "scene_index": 63,
        "start_timecode": "00:06:31.680",
        "end_timecode": "00:06:34.720",
        "audio_speech": "Is a nation's new throne of immortals.",
        "audio_natural": "speech (conf=0.56)"
    },
