    },
    {
        "scene_index": 67,
        "start_timecode": "00:06:44.320",
        "end_timecode": "00:06:49.920",
        "audio_speech": "France this time denied, defied.",
        "audio_natural": "speech (conf=0.48)"
    },
    {
        "scene_index": 68,
        "start_timecode": "00:06:49.920",
        "end_timecode": "00:07:04.320",
        "audio_speech": "Messi fell to his knees, Peter, in the center circle. He couldn't move. He fell to his knees and was surrounded by teammates. Incredible scenes here.",
